{
  "id": "material-you-colors",
  "name": "Material You Colors (KDE/Qt & terminals)",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Applies the wallpaper palette to KDE/Qt apps, Konsole, KSyntaxHighlighting, window decorations and terminals. Every setting here is re-read by the wallpaper switcher too, so it stays in effect on the next wallpaper change.",
  "permissions": [
    "system-exec",
    "notifications"
  ],
  "author": "bhavya",
  "icon": "palette",
  "enabledByDefault": true,
  "runtimeDeps": [
    "kde-material-you"
  ],
  "provides": {
    "services": [
      {
        "id": "materialYouColors",
        "entry": "MaterialYouColors.qml"
      }
    ],
    "launcherActions": [
      {
        "id": "retheme",
        "exec": [
          "kde-material-you"
        ]
      }
    ]
  },
  "settings": [
    {
      "key": "ncolor",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 6,
      "step": 1,
      "label": "Wallpaper colour to theme from",
      "description": "Which of the wallpaper's colours to use. 0 is the shell's own.",
      "icon": "colorize"
    },
    {
      "key": "contrast",
      "type": "real",
      "default": 0,
      "min": -1,
      "max": 1,
      "label": "Contrast",
      "description": "Pushes foreground and background apart. 0 is the Material default.",
      "icon": "contrast"
    },
    {
      "key": "chromaMultiplier",
      "type": "real",
      "default": 1,
      "min": 0,
      "max": 3,
      "label": "Saturation",
      "description": "1 is unchanged, 0 is grey.",
      "icon": "water_drop"
    },
    {
      "key": "toneMultiplier",
      "type": "real",
      "default": 1,
      "min": 0,
      "max": 3,
      "label": "Lightness",
      "description": "1 is unchanged.",
      "icon": "brightness_6"
    },
    {
      "key": "frameContrast",
      "type": "real",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "label": "Frame contrast",
      "description": "Visibility of the borders between panes in Qt apps.",
      "icon": "border_outer",
      "group": "Qt apps"
    },
    {
      "key": "toolbarOpacity",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Toolbar opacity, light",
      "icon": "opacity",
      "group": "Qt apps"
    },
    {
      "key": "toolbarOpacityDark",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Toolbar opacity, dark",
      "icon": "opacity",
      "group": "Qt apps"
    },
    {
      "key": "terminal",
      "type": "bool",
      "default": true,
      "label": "Theme terminals",
      "description": "Also repaints terminals that are already open.",
      "icon": "terminal",
      "group": "Terminals"
    },
    {
      "key": "pywal",
      "type": "bool",
      "default": true,
      "label": "Write pywal files",
      "description": "~/.cache/wal/*, for anything that reads a pywal palette.",
      "icon": "folder_data",
      "group": "Terminals"
    },
    {
      "key": "pywalMode",
      "type": "enum",
      "default": "auto",
      "label": "Terminal light/dark",
      "description": "Terminals can stay dark while the session goes light.",
      "icon": "dark_mode",
      "options": [
        {
          "value": "auto",
          "label": "Follow the session"
        },
        {
          "value": "dark",
          "label": "Always dark"
        },
        {
          "value": "light",
          "label": "Always light"
        }
      ],
      "group": "Terminals"
    },
    {
      "key": "konsole",
      "type": "bool",
      "default": true,
      "label": "Theme Konsole",
      "description": "Also switches open windows onto it.",
      "icon": "terminal",
      "group": "Konsole"
    },
    {
      "key": "konsoleOpacity",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Konsole opacity, light",
      "icon": "opacity",
      "group": "Konsole"
    },
    {
      "key": "konsoleOpacityDark",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Konsole opacity, dark",
      "icon": "opacity",
      "group": "Konsole"
    },
    {
      "key": "konsoleBlur",
      "type": "bool",
      "default": false,
      "label": "Blur behind Konsole",
      "icon": "blur_on",
      "group": "Konsole"
    },
    {
      "key": "decorations",
      "type": "bool",
      "default": true,
      "label": "Theme window decorations",
      "description": "Breeze, Klassy and KWin outlines, where installed.",
      "icon": "window",
      "group": "Window decorations"
    },
    {
      "key": "titlebarOpacityEnable",
      "type": "bool",
      "default": false,
      "label": "Set titlebar opacity",
      "description": "Off leaves each decoration's own setting alone.",
      "icon": "opacity",
      "group": "Window decorations"
    },
    {
      "key": "titlebarOpacity",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Titlebar opacity, light",
      "icon": "opacity",
      "group": "Window decorations"
    },
    {
      "key": "titlebarOpacityDark",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Titlebar opacity, dark",
      "icon": "opacity",
      "group": "Window decorations"
    },
    {
      "key": "darkerWindowList",
      "type": "string",
      "default": "",
      "label": "Darker titlebar",
      "description": "Space separated window classes. Needs KWin.",
      "icon": "filter_alt",
      "placeholder": "code foot",
      "group": "Window decorations"
    },
    {
      "key": "onChangeHook",
      "type": "string",
      "default": "",
      "label": "Run after applying",
      "description": "Shell command, run once the colours are written.",
      "icon": "terminal",
      "placeholder": "notify-send 'Theme applied'",
      "group": "Advanced"
    }
  ]
}
