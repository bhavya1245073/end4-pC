{
  "$schema": "../../core/manifest.schema.json",
  "id": "dropover",
  "name": "Drop Shelf",
  "version": "1.1.0",
  "apiVersion": 1,
  "description": "Drag-and-drop movable shelf for parking files and images between windows.",
  "permissions": [
    "clipboard"
  ],
  "author": "illogical-impulse",
  "icon": "move_to_inbox",
  "enabledByDefault": true,
  "provides": {
    "panels": [
      {
        "id": "dropover",
        "entry": "DropShelfPanel.qml"
      }
    ],
    "contextMenuItems": [
      {
        "id": "shelf",
        "label": "Drop Shelf",
        "icon": "stacks",
        "order": 30,
        "badge": "dropover:count",
        "panel": {
          "id": "dropover",
          "args": {
            "x": "$menuX",
            "y": "$menuY"
          }
        }
      }
    ],
    "ipc": [
      {
        "entry": "DropoverIpc.qml",
        "target": "dropover"
      }
    ]
  }
}
